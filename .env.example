# Copy to .env.local (dev) or .env (VPS). Never commit real values.

# App
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_GOOGLE_DOMAIN=choyou.fr

# Database (Neon, eu-central-1)
# Pooled URL (-pooler host). A localhost URL uses a local Postgres (dev / e2e).
DATABASE_URL=
# Direct URL, used by `prisma db push`.
DIRECT_URL=

# App e-mails (magic links, invitations)
RESEND_API_KEY=
EMAIL_FROM="Campaign · ChoYou <campaign@choyou.fr>"

# AI (lot 2)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT_PER_BRAND=300

# n8n (lot 3)
N8N_API_TOKEN=
N8N_VALIDATION_WEBHOOK_URL=

# Security
KIT_SIGNING_SECRET=
# 32 bytes, base64 (lot 4)
ENCRYPTION_KEY=

# Media (lot 4)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# LinkedIn (lot 4)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=
