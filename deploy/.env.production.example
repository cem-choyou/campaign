# Copy to deploy/.env on the VPS (chmod 600). Never commit real values.
# Docker env files do not support comments at the end of a line: keep comments on their own line.
NODE_ENV=production
AUTH_URL=https://campaign.choyou-tools.fr
AUTH_TRUST_HOST=true
# openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_GOOGLE_DOMAIN=choyou.fr
# Neon, branch main: pooled URL (-pooler host) for the app…
DATABASE_URL=
# …and direct URL for `prisma db push`.
DIRECT_URL=
RESEND_API_KEY=
EMAIL_FROM=Campaign · ChoYou <campaign@choyou.fr>
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
AI_MODEL=claude-sonnet-5
AI_DAILY_LIMIT_PER_BRAND=300
